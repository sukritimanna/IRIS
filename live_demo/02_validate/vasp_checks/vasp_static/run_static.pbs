#!/bin/bash
#PBS -A <project-id>
#PBS -l nodes=1:ppn=32
#PBS -l walltime=01:00:00
#PBS -N batio3_static
#PBS -j oe
module purge
module load impi/2019/2019.Update.9
module load intel/19/19.1.3
module load hdf5/1.10/intel-19/1.10.8-3
module load --auto --silent vasp6/6.3
export OMP_NUM_THREADS=1
ulimit -s unlimited
cd "$PBS_O_WORKDIR"
NP=`wc -l < $PBS_NODEFILE`
cp INCAR.${FUNC:-PBEsol} INCAR
echo "start `date -Is`"; mpirun -np $NP vasp_std > vasp.out; echo "rc $?  end `date -Is`"
grep "free  energy   TOTEN" OUTCAR | tail -1
